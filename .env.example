# ── Login (only this one account can sign in) ──────────────────────────
ADMIN_USERNAME=ideal
ADMIN_PASSWORD=choose-a-long-password
# Random string, 32+ characters. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# ── Storage: pick ONE option ───────────────────────────────────────────
# Option A – Turso (recommended)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Option B – Google Sheet (via the Apps Script in /apps-script/Code.gs)
# GOOGLE_SCRIPT_URL=
# GOOGLE_SCRIPT_TOKEN=

# Option C – Upstash Redis (Vercel → Storage → Upstash). These are filled in
# automatically when you connect the database to the project in Vercel.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Optional branding ──────────────────────────────────────────────────
# NEXT_PUBLIC_BUSINESS_NAME=Ideal Car Insurance
# NEXT_PUBLIC_BUSINESS_TAGLINE=Drive safe • Stay protected
# NEXT_PUBLIC_BUSINESS_PHONE=058 665 4412
# NEXT_PUBLIC_OWNER_NAME=Rashid      (shown in the dashboard greeting)
